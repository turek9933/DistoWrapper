# Kopia do lokalnego .env:
#   cp .env.example .env
# .env nie trafia do repozytorium.

# Wymagane w produkcji:
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Domyślne wartości:
DJANGO_DEBUG=0
DJANGO_HSTS_SECONDS=0
DATA_UPLOAD_MAX_NUMBER_FILES=1000
FILE_UPLOAD_MAX_MEMORY_SIZE_MB=5

DISTO_PASSWORD=
DISTO_MAX_FILES=40
DISTO_MAX_FILE_MB=25
DISTO_MAX_TOTAL_MB=150
DISTO_EPHEMERAL_DIR=
DISTO_EPHEMERAL_TTL=900
DISTO_RATE_LIMIT=30
DISTO_RATE_WINDOW=600
# Lokalnie: REMOTE_ADDR. Za Cloudflare: HTTP_CF_CONNECTING_IP.
DISTO_CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP

# Tylko dla profilu "tunnel":
CLOUDFLARE_TUNNEL_TOKEN=

# Opcjonalne dla docker compose --profile cli:
UID=1000
GID=1000
